// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./client/"
}

datasource db {
  provider = "sqlite"
}

model AppConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 单用户表
model User {
  id                Int      @id @default(autoincrement())
  passwordHash      String
  passwordSalt      String   @default("")
  keyBlob           String   @default("") // v2 格式：AES-256-GCM(KEK, DEK)
  kdfParams         String   @default("") // JSON: {"algorithm":"argon2id","m":65536,"t":2,"p":1,"version":1}
  initTime          DateTime @default(now())
  theme             String   @default("light")
  defaultGroupId    Int      @default(0)
  totpSecret        String   @default("")
  createPwdAlphabet String   @default("")
  createPwdLength   Int      @default(16)
  metadataVersion   Int      @default(1) // 1=凭证名称明文，2=凭证名称已加密（nameEnc）
}

// 凭证分组
model Group {
  id           Int           @id @default(autoincrement())
  name         String
  order        Int           @default(0)
  lockType     String        @default("None") // None | Password | Totp
  passwordHash String? // v2 格式：hex(V)，V = argon2id(password, salt, kdfParams) 输出后 32 字节
  passwordSalt String?
  keyBlob      String? // 预留：分组独立加密（规划中）
  kdfParams    String        @default("") // JSON: 与 User.kdfParams 同构；空串 = 旧版（v1）锁密码，解锁时拒绝并提示重新设置
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
}

// 凭证（密码条目）
model Certificate {
  id        Int      @id @default(autoincrement())
  name      String // 旧明文列：迁移期只读不写，下个大版本删除
  nameEnc   String   @default("") // 凭证名称密文（v2 格式：DEK 加密），空串 = 未迁移
  groupId   Int
  content   String   @default("")
  order     Int      @default(-1)
  markColor String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// 安全通知
model Notification {
  id      Int      @id @default(autoincrement())
  title   String
  content String   @default("")
  date    DateTime @default(now())
  type    Int      @default(1)
  isRead  Int      @default(0)
}
