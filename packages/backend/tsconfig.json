{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "removeComments": true,
    "noEmit": true,
    "module": "preserve",
    "outDir": "./dist",
    "baseUrl": "./",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["./prisma/client/*"],
      "@cube-password/shared/*": ["../shared/src/*"]
    }
  }
}
