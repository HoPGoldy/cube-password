{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@frontend/*": ["../frontend/src/*"]
    }
  },
  "include": ["**/*.ts"]
}
