# E2E 测试目标服务地址
E2E_BASE_URL=http://localhost:3500

# 登录密码
# 数据库未初始化时，global-setup 会以本密码调用 /api/auth/init 自动创建管理员用户
# （后端存储 SHA512(salt + password)，salt 使用固定值 "e2e-fixed-salt"，可复现）。
# 复用已有开发库（如本地 packages/backend/storage/main.db）时，本密码必须与库中
# 现有的用户密码一致，否则 global-setup 会报错提示（仅探测一次，不会触发 3 次登录锁定）。
# 提示：packages/backend/.env 中的 BACKEND_LOGIN_PASSWORD 实际未被任何代码读取；
# 本地开发库的密码是 admin123，运行测试时请使用 E2E_LOGIN_PASSWORD=admin123。
E2E_LOGIN_PASSWORD=admin